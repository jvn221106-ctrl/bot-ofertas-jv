# Fuso/agenda
TZ=America/Sao_Paulo
CRON=*/15 7-23 * * *

# Servidor local do painel/healthcheck
PORT=3000
DATA_DIR=./data

# Mercado Livre
ML_SITE_ID=MLB
# Preferencial: autorize pelo painel e renove o token automaticamente.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Mesma URL cadastrada no aplicativo, terminando em /oauth/callback.
ML_REDIRECT_URI=
# Alternativa para teste: token manual (não oferece renovação automática).
ML_ACCESS_TOKEN=
ML_REQUEST_TIMEOUT_MS=20000
MIN_DISCOUNT_PERCENT=20
CANDIDATES_PER_CATEGORY=30

# Categorias/famílias desejadas, separadas por vírgula.
CATEGORY_PATTERNS=Esportes e Fitness,Calçados Roupas e Bolsas,Games,Eletrônicos Áudio e Vídeo,Celulares e Telefones,Informática

# WhatsApp
# O ID do grupo termina normalmente em @g.us. Descubra-o após conectar o número novo.
WHATSAPP_GROUP_ID=
WA_AUTH_DIR=./data/wa-auth
WA_CONNECT_TIMEOUT_MS=60000

# Afiliado
# Por enquanto o bot só publica quando existir um link oficial cadastrado para o item.
# Cadastre pelo formulário do painel ou pela API /api/affiliate-link.
# A validação do formato não confirma comissão nem que o link aponta ao item informado.
AFFILIATE_PROFILE=jvn2211
AFFILIATE_LABEL_PREFIX=whatsapp

# Segurança operacional
# true = simula, sem enviar, sem gravar um post e sem bloquear o produto por 30 dias.
DRY_RUN=true
# Não publicar o mesmo item novamente por este número de dias.
REPEAT_BLOCK_DAYS=30
