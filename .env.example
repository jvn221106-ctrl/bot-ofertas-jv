# Fuso/agenda
TZ=America/Sao_Paulo
CRON=*/15 7-23 * * *

# Servidor local do painel/healthcheck
PORT=3000

# Mercado Livre
ML_SITE_ID=MLB
# Necessário para endpoints autenticados da API do Mercado Livre.
ML_ACCESS_TOKEN=
MIN_DISCOUNT_PERCENT=20
CANDIDATES_PER_CATEGORY=30

# Categorias/famílias desejadas, separadas por vírgula.
CATEGORY_PATTERNS=Esportes e Fitness,Calçados Roupas e Bolsas,Games,Eletrônicos Áudio e Vídeo,Celulares e Telefones,Informática

# WhatsApp
# O ID do grupo termina normalmente em @g.us. Descubra-o após conectar o número novo.
WHATSAPP_GROUP_ID=
WA_AUTH_DIR=./data/wa-auth

# Afiliado
# Por enquanto o bot só publica quando existir um link de afiliado validado para o item.
# Cadastre pelo painel/API ou pelo arquivo data/affiliate-links.json.
AFFILIATE_PROFILE=jvn2211
AFFILIATE_LABEL_PREFIX=whatsapp

# Segurança operacional
# true = não envia mensagem; apenas mostra o que faria.
DRY_RUN=true
# Não publicar o mesmo item novamente por este número de dias.
REPEAT_BLOCK_DAYS=30
